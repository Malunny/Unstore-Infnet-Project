@page
@model ProductsPage
@{
    ViewData["Title"] = "Unstore - Produtos";
}

<div class="display-flex-columns paper-1">
    <ul>
        @foreach (var produto in Model.Produtos)
        {
            <li>
                <div>
                    <h5>@produto.Nome</h5>
                    <p>@produto.Valor</p>
                </div>
            </li>
        }
    </ul>
</div>