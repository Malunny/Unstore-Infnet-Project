@page "/produtos/administracao"
@using UnstoreProjectADS.Core.Enums
@using UnstoreProjectADS.Core.Extensoes
@model PaginaAdministracaoProdutos
@{
    ViewData["Title"] = "Unstore - Editando produto";
    var cargoAdministradorEstoque = Cargos.AdministradorEstoque.PegarNome();
    var cargoAdministradorSistema = Cargos.AdministradorSistema.PegarNome();
    var cargoFinanceiro = Cargos.Financeiro.PegarNome();
    var cargoVendas = Cargos.Vendas.PegarNome();
}

<div class="card">
    <header class="card-header">
        <h3 style="margin:0;">Administrador de produto</h3>
        @if (Model.Creating)
        {
            <b class="text-info" style="margin:0;">Criando produto</b>
        }
    </header>
    <div class="card-body">
        <form method="post" class="display-flex-columns paper-2" enctype="multipart/form-data">
            <label for="ImagemUpload" class="form-label">Escolha uma imagem para o produto</label>
            <input type="file" asp-for="ArquivoImagem" class="form-control" accept="image/*" />
            
            <label for="Nome">Nome</label>
            <input class="form-control" type="text" id="Nome"
                   readonly="@(!Model.User.VerificarCargoVendas() && !Model.User.VerificarCargoAdministradorSistema())"
                   asp-for="Produto.Nome"/>
            <label for="Descricao">Descrição</label>
            <textarea class="form-control"
                   type="text" id="Descricao" readonly="@(!Model.User.VerificarCargoVendas() && !Model.User.VerificarCargoAdministradorSistema())"
                   asp-for="Produto.Descricao">
            </textarea>

            <label for="Valor">Valor</label>
            <input class="form-control"
                   inputmode="numeric"
                   type="text" readonly="@(!Model.User.VerificarCargoVendas() && !Model.User.VerificarCargoFuncionario() && !Model.User.VerificarCargoAdministradorSistema())"
                   id="Valor" asp-for="Produto.Valor"/>

            <label for="QuantidadeEstoque">QuantidadeEstoque</label>
            <input class="form-control"
                   type="number" readonly="@(!Model.User.VerificarCargoVendas() && !Model.User.VerificarCargoAdministradorSistema())"
                   id="QuantidadeEstoque" asp-for="Produto.QuantidadeEstoque"/>

            <button type="submit">Salvar</button>
        </form>
    </div>
    
    <span class="text-success text-center p-1">
        @TempData["ProdutoSalvo"]
    </span>
    
    <span class="text-danger text-center p-1">
        @TempData["ProdutoNaoSalvo"]
    </span>
</div>

