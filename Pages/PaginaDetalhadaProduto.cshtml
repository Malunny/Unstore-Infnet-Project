@page "/produtos/{produtoId:int}"
@using UnstoreProjectADS.Views.ViewModels
@model PaginaDetalhadaProduto

@{
    ViewData["Title"] = $"Unstore - {Model?.Produto?.Nome ?? "Não encontrado"}";
}

@if (Model?.Produto != null)
{
    var imagemUrl = new ViewModelProduto(Model.Produto).ImagemUrl;
    <div class="card shadow-sm">
        <header class="card-header">
            <h1>@Model.Produto.Nome</h1>
        </header>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(imagemUrl))
            {
                <img class="product-image img-fluid" 
                     style="height: 20em;"
                     src="@Url.Content(imagemUrl)" 
                     alt="@Model.Produto.Nome" />
            }
            <div style="width: 50%;">
                <h3>Descrição</h3>
                <p>
                    @Model.Produto.Descricao;
                </p>
            </div>
            <div>
                <h3>Preço</h3>
                <p>
                    R$ @Model.Produto.Valor.ToString("F2")
                </p>
            </div>
            <p>
                Quantidade em estoque: @Model.Produto.QuantidadeEstoque
            </p>
            <div>
                <span class="alert-success">
                    @TempData["StatusCarrinho"]
                </span>
            </div>
        </div>
            
        <div class="card-footer d-flex flex-row gap-1">
            <form method="post" asp-page-handler="AdicionarEComprar">
                <button class="btn btn-primary" type="submit">
                    Comprar
                </button>
            </form>
            <form method="post" asp-page-handler="AdicionarCarrinho">
                <button class="btn btn-outline-primary" type="submit">
                    Adicionar no carrinho
                </button>
            </form>
            <form method="post" asp-page-handler="Retornar">
                <button class="btn btn-outline-primary" type="submit">
                    Retornar à lista
                </button>
            </form>
        </div>
    </div>
    @if (TempData["ProblemaAdicionarCarrinho"] != null)
    {
        <div class="toast show p-1 position-fixed" style="bottom: 10%;" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <span class="text-info flex-grow-1">
                    Alerta!
                </span>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">@TempData["ProblemaAdicionarCarrinho"]</div>
        </div>
    }
}
else
{
    <div class="paper-1">
        <h1>Produto não encontrado!</h1>
    </div>
}