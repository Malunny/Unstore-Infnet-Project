@page "/iniciarSessao"
@using Microsoft.AspNetCore.Identity.Data
@model PaginaIniciarSessao
@{
    ViewData["Title"] = "Unstore - Iniciar Sessão";
}

<div class="w-100 justify-content-center align-items-center d-flex" style="height: 80vh;">
    <div class="card w-50">
        <h1 class="text-center w-auto p-1">Iniciar Sessão</h1>
    
        <form method="post">
            <div class="d-flex flex-column card-body" style="padding: 1em 1em 1em 1em;">
                <label class="form-label" 
                       for="Email">Email</label>
                <input type="email"
                       class="form-control"
                       id="Email" asp-for="Form.Email"/>
                <label class="form-label" 
                    for="Password">Password</label>
                <input type="password" 
                       class="form-control"
                       id="Password" asp-for="Form.Password"/>
                <p class="text-danger">
                    @TempData["ErrosInicioSessao"]
                </p>
            </div>
            
            
            <button class="btn btn-primary m-1" style="width: 98.5%;" 
                type="submit">Login</button>
        </form>
    </div>
</div>