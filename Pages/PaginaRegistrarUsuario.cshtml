@page "/registrar"
@using Microsoft.AspNetCore.Identity.Data
@model PaginaRegistrarUsuario
@{
    ViewData["Title"] = "Unstore - Registrar";
}

<div class="text-center">
    <div class="card w-75 m-auto">
        <h1 class="display-4">Registrar</h1>
        <hr/>
        <form method="post" style="display: flex; flex-direction: column; text-align: left;">
            <div class="card-body d-flex flex-column p-2">
                <h3 class="text-center p-1">Informações pessoais</h3>
                <label for="Email" class="form-label">Email</label>
                <input type="email" id="Email" class="form-control"
                       asp-for="Form.Email"/>
                <span asp-validation-for="Form.Email" class="text-danger"></span>
                
                <label for="Password" class="form-label">Password</label>
                <input type="password" id="Password" class="form-control"
                       asp-for="Form.Senha"/>
                <span asp-validation-for="Form.Senha" class="text-danger"></span>
                
                <label for="Nome" class="form-label">Nome</label>
                <input type="text" id="Nome" class="form-control"
                       asp-for="Form.Nome"/>
                <span asp-validation-for="Form.Nome" class="text-danger"></span>
                

                <h3 class="text-center p-1">Endereços</h3>
                <div class="d-flex flex-column gap-2">
                    @for (int i = 0; i < Model.Form.Enderecos.Count; i++)
                    {
                        <div class="d-flex flex-column w-100">
                            <div class="card">
                                <div class="card-header">
                                    <b>Endereço @(i + 1)</b>
                                </div>
                                <div class="card-body d-flex flex-column p-1 
                                        overflow-y-scroll" style="height: 25vh;">
                                    <label for="Estado">Estado</label>
                                    <input type="text" id="Estado" class="form-control" asp-for="Form.Enderecos[i].Estado"/>
                                    
                                    <span asp-validation-for="Form.Enderecos[i].Estado" class="text-danger d-inline-block"></span>

                                    <label for="Municipio">Município</label>
                                    <input type="text" id="Municipio" class="form-control"
                                           asp-for="Form.Enderecos[i].Municipio"/>
                                    <span asp-validation-for="Form.Enderecos[i].Municipio" class="text-danger"></span>

                                    <label for="Rua">Rua</label>
                                    <input type="text" id="Rua" class="form-control"
                                           asp-for="Form.Enderecos[i].Rua"/>
                                    <span asp-validation-for="Form.Enderecos[i].Rua" class="text-danger"></span>

                                    <label for="Numero">Numero</label>
                                    <input type="text" id="Numero" class="form-control"
                                           asp-for="Form.Enderecos[i].Numero"/>
                                    <span asp-validation-for="Form.Enderecos[i].Numero" class="text-danger"></span>

                                    <label for="Complemento">Complemento</label>
                                    <input type="text" id="Complemento" class="form-control"
                                           asp-for="Form.Enderecos[i].Complemento"/>
                                    <span asp-validation-for="Form.Enderecos[i].Complemento" class="text-danger"></span>

                                    <label for="CEP">CEP</label>
                                    <input type="text" id="CEP" class="form-control"
                                           asp-for="Form.Enderecos[i].CEP"/>
                                    <span asp-validation-for="Form.Enderecos[i].CEP" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="d-flex flex-column text-center">
                    @if (!Model.RespostaValidacao.Ok)
                    {
                        foreach (var mensagemErro in Model.RespostaValidacao.MensagensErro)
                        {
                            <p class="text-danger">@mensagemErro</p>
                        }
                    }
                </div>
            </div>
            <div class="card-footer">
                <button type="submit" class="btn btn-primary w-100">Registrar-se</button>
            </div>
        </form>
    </div>
</div>