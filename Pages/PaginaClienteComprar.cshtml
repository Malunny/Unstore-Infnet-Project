@page "/cliente/comprar"
@using UnstoreProjectADS.Core.Extensoes
@model PaginaClienteComprar

@{
    ViewData["Title"] = "Unstore - Comprar";
}

@if (Model.Cliente != null)
{
    <div class="card">
        <header class="card-header">
            <h3>Finalizar Compra</h3>
        </header>
        <div class="card-body">
            @if (TempData["ProblemaCompra"] != null)
            {
                <div class="alert alert-danger">@TempData["ProblemaCompra"]</div>
            }

            @if (Model.Cliente.Carrinho.PegarProdutos().Any())
            {
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Preço</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var produto in Model.Cliente.Carrinho.PegarProdutos())
                    {
                        <tr>
                            <td>@produto.Nome</td>
                            <td>@produto.Valor.TransformarEmMonetario()</td>
                        </tr>
                    }
                    </tbody>
                </table>

                <p><b>Frete: </b>@Model.Frete.TransformarEmMonetario()</p>
                <p><b>Total: </b>@((Model.TotalProdutos + Model.Frete).TransformarEmMonetario())</p>

                <form method="post">
                    <div class="mb-3">
                        <label for="EnderecoId">Endereço de entrega</label>
                        <select id="EnderecoId" class="form-select" asp-for="EnderecoId">
                            @foreach (var endereco in Model.Cliente.Enderecos)
                            {
                                <option value="@endereco.Id">
                                    @endereco.Rua, @endereco.Numero - @endereco.Municipio/@endereco.Estado
                                </option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="FormaPagamento">Forma de pagamento</label>
                        <select id="FormaPagamento" class="form-select" asp-for="FormaPagamento">
                            @foreach (var forma in Model.FormasPagamento)
                            {
                                <option value="@forma">@forma</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Pagar</button>
                    <a class="btn btn-outline-dark" asp-page="/PaginaClienteCarrinho">Desistir</a>
                </form>
            }
            else
            {
                <p>Seu carrinho está vazio.</p>
            }
        </div>
    </div>
}
else
{
    <div class="paper-1">
        <h1>Cliente não encontrado</h1>
    </div>
}