@page "/cliente/carrinho"
@using UnstoreProjectADS.Views.ViewComponents
@model PaginaClienteCarrinho

@{
    ViewData["Title"] = "Unstore - Carrinho";
}

@if (Model.Cliente != null)
{
    <div class="card">
        <header class="card-header">
            <h3>Seu Carrinho</h3>
        </header>
        <div class="card-body">
            <div class="product-displayer gap-2 flex-grow-1 overflow-auto p-3">
                @foreach (var produto in Model.Carrinho.Produtos)
                {
                    @await Component.InvokeAsync(typeof(CardProdutoViewComponent), produto)
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="paper-1">
        <h1>Cliente não encontrado</h1>
    </div>
}
