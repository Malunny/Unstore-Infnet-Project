@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Unstore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UnstoreProjectADS.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Unstore E-commerce</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex">
                    <ul class="nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Tela Inicial</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/PaginaListagemProdutos">Produtos</a>
                        </li>
                        @if (User.PossuiCargoFuncionario())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" role="button" data-bs-toggle="dropdown" href="#">Administração</a>
                                <ul class="dropdown-menu">
                                    @if (User.PossuiCargoVendas() || User.PossuiCargoAdministradorSistema() || User.PossuiCargoAdministradorEstoque())
                                    {
                                        <li class="dropdown-item">
                                            <a class="nav-link text-dark" asp-area="" asp-page="/PaginaListagemProdutosAdministracao" asp-route-pagina="1">
                                                Administrar Produtos
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (!User.PossuiCargoFuncionario() && (User.Identity?.IsAuthenticated ?? false))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/PaginaClienteCarrinho">Meu Carrinho</a>
                            </li>
                        }
                        @if (!User.Identity?.IsAuthenticated ?? false)
                        {
                            <div class="last-item" style="display: flex; gap: 0.5em;">
                                <li class="nav-item">
                                    <a class="btn btn-outline-dark" asp-area=""
                                       asp-page="/PaginaIniciarSessao">Iniciar Sessão</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-primary" asp-area="" asp-page="/PaginaRegistrarUsuario">Registrar-se</a>
                                </li>
                            </div>
                        }
                        else
                        {   
                            <div class="last-item user-account-container">
                                <ul style="display: flex; flex-direction: row; list-style: none; gap: 0.5em; align-items: center;">
                                    <li>@(User?.FindFirst(ClaimTypes.Email)?.Value ?? "Sem sessão")</li>
                                    @foreach (var role in User?.FindAll(ClaimTypes.Role) ?? [])
                                    {
                                        <li>| @role.Value</li>
                                    }
                                    <li>
                                        <form method="post" asp-page="/PaginaSairDeSessao">
                                            <button type="submit" class="btn btn-outline-dark">Sair da sessão</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - UnstoreProjectADS - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
