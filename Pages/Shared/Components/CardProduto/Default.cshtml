@using UnstoreProjectADS.Core.Extensoes
@model UnstoreProjectADS.Views.ViewModels.ViewModelProduto

<div class="card product-display">
    @if (!string.IsNullOrWhiteSpace(Model.ImagemUrl))
    {
        <a asp-page="/PaginaDetalhadaProduto" asp-route-produtoId="@Model.Id">
            <img class="product-image" src="@Url.Content(Model.ImagemUrl)" alt="@Model.Nome" loading="lazy" />
        </a>
    }
    <div class="card-body">
        <h5 class="card-title">
            <a asp-page="/PaginaDetalhadaProduto" asp-route-produtoId="@Model.Id">@Model.Nome</a>
        </h5>
    </div>
    <div class="card-footer">
        <b>@Model.Valor.TransformarEmMonetario()</b>
    </div>
</div>
