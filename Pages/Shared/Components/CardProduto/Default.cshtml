@model UnstoreProjectADS.ViewModels.ViewModelProduto

@{
    const int tamanhoMaximoDescricao = 50;

    var descricao = Model.Descricao;
    
    if (tamanhoMaximoDescricao < descricao.Length)
    {
        descricao = descricao.Substring(0, tamanhoMaximoDescricao).Trim() + "...";
    }
}

<div class="card product-display">
    <div class="card-body">
        <h5 class="card-title text-truncate">
            <a asp-page="/PaginaDetalhadaProduto" asp-route-produtoId="@Model.Id">
                @Model.Nome
            </a>
        </h5>
        <b>Descrição</b>
        <p class="card-text text-muted small">@descricao</p>
    </div>
    <div class="card-footer">
        <b>R$ @Model.Valor.ToString("F2")</b>
        <p class="text-muted">Estoque: @Model.QuantidadeEmEstoque</p>
    </div>
</div>
