@page "/administracao/produtos"
@using UnstoreProjectADS.Extensoes.Monetario
@model PaginaListagemProdutoAdministracao

@{
    ViewData["Title"] = "[ADM] Unstore - Produtos";
}

<div class="card gap-3">
    <header class="card-header">
        <h3>
            Administração de Produtos
        </h3>
        <a class="btn btn-primary " role="button"
           asp-area="" asp-page="/PaginaAdministracaoProdutos" asp-route-produtoId="0">Criar Produto</a>
    </header>
    <div class="container" style="height: 68vh; overflow-y: scroll">
        <table class="table table-hover">
            <thead>
            <tr class="">
                <th>
                    Número
                </th>
                <th>
                    Nome
                </th>
                <th>
                    Preço
                </th>
                <th>
                    Estoque
                </th>
                <th>
                    Opções
                </th>
            </tr>
            </thead>
            <tbody>
            @foreach (var produto in Model.Produtos)
            {
                <tr>
                    <td>
                        @produto.Id
                    </td>
                    <td>
                        @produto.Nome
                    </td>
                    <td>
                        @produto.Valor.TransformarEmMonetario()
                    </td>
                    <td>
                        @produto.QuantidadeEstoque
                    </td>
                    <td class="d-flex gap-1">
                        <form>
                            <button type="submit" class="btn btn-outline-dark" asp-page="/PaginaDetalhadaProduto" asp-route-produtoId="@produto.Id">
                                <i class="bi bi-pencil-fill"></i>
                            </button>
                        </form>
                        <form method="post">
                            <button class="btn btn-primary"
                                    asp-page="/DeletarProduto"
                                    asp-route-produtoId="@produto.Id"
                                    type="submit">
                                <i class="bi bi-trash" aria-label="Deletar"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    
    <footer class="card-footer">
        <nav class="pagination">
            <nav>
                <ul class="pagination">
                    <li class="page-item">
                        @if (Model.PossuiPaginaAnterior)
                        { <a class="page-link" 
                             asp-route-tamanhoPagina="@Model.TamanhoPagina"
                             asp-route-pesquisa="@Model.TextoPequisa" asp-route-pagina="@(Model.NumeroPagina - 1)">Anterior</a> }
                        else
                        { <a class="page-link disabled" aria-disabled="True">Anterior</a> }
                    </li>
                    @for (int i = 0; i < Model.QuantidadePaginas; i++)
                    {
                        var numeroPagina = i + 1;
                        <li class="page-item">
                            <a class="page-link" asp-route-pagina="@numeroPagina" 
                               asp-route-tamanhoPagina="@Model.TamanhoPagina"
                               asp-route-pesquisa="@Model.TextoPequisa">@numeroPagina</a>
                        </li>
                    }
                    <li class="page-item">
                        @if (Model.PossuiProximaPagina)
                        { <a class="page-link" asp-route-pagina="@(Model.NumeroPagina + 1)"
                             asp-route-tamanhoPagina="@Model.TamanhoPagina"
                             asp-route-pesquisa="@Model.TextoPequisa">Próximo</a> }
                        else
                        { <a class="page-link disabled" aria-disabled="True">Próximo</a> }
                    </li>
                </ul>
            </nav>
        </nav>
    </footer>
</div>
