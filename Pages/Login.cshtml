@page
@using Microsoft.AspNetCore.Identity.Data
@model LoginPage
@{
    ViewData["Title"] = "Unstore - Login";
}

<div class="text-center">
    <h1 class="display-4">Login</h1>
    
    <form method="post" style="display: flex; 
        flex-direction: column;
         text-align: left;">
        
        <div class="paper-1 display-flex-columns" style="padding: 1em 1em 1em 1em;">
            <label for="Email">Email</label>
            <input type="email" id="Email" asp-for="Form.Email"/>
            <label for="Password">Password</label>
            <input type="password" id="Password" asp-for="Form.Password"/>
            <button type="submit">Login</button>
        </div>
    </form>
</div>