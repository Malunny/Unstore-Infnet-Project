@page
@model IndexModel
@{
    ViewData["Title"] = "Unstore";
}

<div class="container-fluid">
    <header>
        <h4 class="text-center">
            Olá, @(Model.User.ColetarNome() ?? "Usuário!")
        </h4>
    </header>
    <div class="card">
        <div class="card-header">
            <h4>
                Acesso rápido
            </h4>
        </div>
        <div class="card-body">
            <nav class="nav">
                <ul class="navbar-nav">
                    @if (User.VerificarCargoFuncionario())
                    {
                        <li class="nav-item">
                            <a class="btn btn-secondary"
                               asp-page="/PaginaListagemProdutosAdministracao">
                                <i class="bi bi-bag-fill">
                                </i>
                                <b>
                                    Administrar produtos
                                </b>
                            </a>
                            @if (User.VerificarCargoAdministradorSistema())
                            {
                                <a class="btn btn-secondary"
                                   asp-page="/PaginaAdministracaoRegistradorUsuario">
                                    <i class="bi bi-bag-fill">
                                    </i>
                                    <b>
                                        Criar Usuário
                                    </b>
                                </a>
                            }
                        </li>   
                    }
                    else if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item">
                            <a class="btn btn-secondary"
                               asp-page="/PaginaClienteCarrinho">
                                <i class="bi bi-cart"></i>
                                <b>
                                    Carrinho
                                </b>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>   
</div>
